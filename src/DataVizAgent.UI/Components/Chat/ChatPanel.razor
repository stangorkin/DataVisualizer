@using System.IO
@using DataVizAgent.Services
@inject IChatService ChatService
@inject LlamaConfig LlamaConfig
@inject IModelManagerService Models
@implements IDisposable

<div class="chat-panel">
    <div class="chat-header">
        <h3>Chat</h3>
        <div class="model-controls">
            @if (_installedModels.Count > 0)
            {
                <select class="model-select"
                        title="@(LlamaConfig.ModelPath ?? "No model configured")"
                        value="@ActiveModelValue"
                        disabled="@_isThinking"
                        @onchange="OnModelSelected">
                    @foreach (InstalledModel model in _installedModels)
                    {
                        <option value="@model.FullPath">@Path.GetFileNameWithoutExtension(model.FileName)</option>
                    }
                </select>
            }
            else
            {
                <span class="model-pill" title="@(LlamaConfig.ModelPath ?? "No model configured")">@ModelLabel</span>
            }
            <button type="button" class="model-manage-button" title="Switch models or download more" @onclick="() => _libraryOpen = true">Models…</button>
        </div>
    </div>
    @if (_modelSwitchNote is not null)
    {
        <p class="model-switch-note">@_modelSwitchNote</p>
    }
    <div class="chat-messages" @ref="_messageContainer">
        @foreach (var msg in _messages)
        {
            <ChatMessage Role="@msg.Role" Text="@msg.Text" />
        }
        @if (_isThinking && _messages.Count > 0 && string.IsNullOrEmpty(_messages[^1].Text))
        {
            <div class="chat-message assistant thinking">
                <span class="thinking-dots"><span></span><span></span><span></span></span>
                <span class="thinking-elapsed">@ThinkingElapsedLabel</span>
            </div>
        }
    </div>
    <div class="chat-input-row">
        <textarea @bind="_input" @bind:event="oninput"
                  @onkeydown="OnKeyDown"
                  class="chat-input"
                  placeholder="Ask about your data…"
                  rows="2"
                  disabled="@_isThinking" />
        <button class="send-button" @onclick="SendAsync" disabled="@_isThinking">
            @if (_isThinking)
            {
                <span class="btn-spinner"></span>
            }
            Send
        </button>
    </div>
</div>

@if (_libraryOpen)
{
    <ModelLibrary OnClose="CloseLibrary" />
}

@code {
    private record ChatMessageModel(string Role, string Text);

    private readonly List<ChatMessageModel> _messages = [];
    private string _input = string.Empty;
    private bool _isThinking = false;
    private ElementReference _messageContainer;
    private CancellationTokenSource _cts = new();

    private IConversationDisplayHistory? _displayHistory;

    private IReadOnlyList<InstalledModel> _installedModels = [];
    private bool _libraryOpen;
    private string? _modelSwitchNote;

    protected override void OnInitialized()
    {
        ChatService.HistoryCleared += HandleHistoryCleared;
        Models.Changed += HandleModelsChanged;
        _installedModels = Models.GetInstalledModels();

        // Pipelines with persistent conversation (the agent pipeline) expose their prior log so the
        // chat panel can repopulate after a restart or a session load.
        if (ChatService is IConversationDisplayHistory displayHistory)
        {
            _displayHistory = displayHistory;
            _displayHistory.DisplayHistoryChanged += HandleDisplayHistoryChanged;
            LoadDisplayHistory();
        }
    }

    private void LoadDisplayHistory()
    {
        if (_displayHistory is null) return;

        _messages.Clear();
        foreach (ChatHistoryEntry entry in _displayHistory.GetDisplayHistory())
            _messages.Add(new(entry.Role, entry.Text));
    }

    private void HandleDisplayHistoryChanged()
    {
        InvokeAsync(() =>
        {
            LoadDisplayHistory();
            StateHasChanged();
        });
    }

    private DateTime _thinkingSince;

    private string ModelLabel
    {
        get
        {
            string? path = LlamaConfig.ModelPath;
            return string.IsNullOrWhiteSpace(path) ? "no model" : Path.GetFileNameWithoutExtension(path);
        }
    }

    private string ActiveModelValue =>
        _installedModels.FirstOrDefault(IsActiveModel)?.FullPath ?? _installedModels[0].FullPath;

    private bool IsActiveModel(InstalledModel model) =>
        !string.IsNullOrWhiteSpace(LlamaConfig.ModelPath) &&
        string.Equals(model.FullPath, Path.GetFullPath(LlamaConfig.ModelPath), StringComparison.OrdinalIgnoreCase);

    private void HandleModelsChanged()
    {
        InvokeAsync(() =>
        {
            _installedModels = Models.GetInstalledModels();
            StateHasChanged();
        });
    }

    private void OnModelSelected(ChangeEventArgs e)
    {
        string? path = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(path))
            return;

        string? error = Models.SwitchTo(path);
        _modelSwitchNote = error ?? $"Switched to {Path.GetFileNameWithoutExtension(path)} — it loads on your next message.";
    }

    private void CloseLibrary()
    {
        _libraryOpen = false;
        StateHasChanged();
    }

    private string ThinkingElapsedLabel
    {
        get
        {
            int seconds = (int)(DateTime.UtcNow - _thinkingSince).TotalSeconds;
            return seconds >= 60 ? $"{seconds / 60}m {seconds % 60}s" : $"{seconds}s";
        }
    }

    /// <summary>Re-renders once a second while the model works, so the elapsed label ticks.</summary>
    private async Task TickWhileThinkingAsync()
    {
        while (_isThinking)
        {
            await Task.Delay(1000);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _isThinking) return;
        string text = _input.Trim();
        _input = string.Empty;
        _modelSwitchNote = null;
        _isThinking = true;
        _thinkingSince = DateTime.UtcNow;
        _ = TickWhileThinkingAsync();
        _messages.Add(new("user", text));
        _messages.Add(new("assistant", string.Empty));
        await InvokeAsync(StateHasChanged);

        try
        {
            // Each snapshot is the full displayable text so far and replaces the previous one.
            await foreach (string snapshot in ChatService.SendAsync(text, _cts.Token))
            {
                _messages[^1] = _messages[^1] with { Text = snapshot };
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _messages[^1] = _messages[^1] with { Text = $"[Error: {ex.Message}]" };
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            // Drop the bubble when the reply was chart-only (no prose to show).
            if (_messages.Count > 0 && _messages[^1].Role == "assistant" && string.IsNullOrWhiteSpace(_messages[^1].Text))
                _messages.RemoveAt(_messages.Count - 1);

            _isThinking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    private void HandleHistoryCleared()
    {
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        _messages.Clear();
        _input = string.Empty;
        _isThinking = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatService.HistoryCleared -= HandleHistoryCleared;
        Models.Changed -= HandleModelsChanged;
        if (_displayHistory is not null)
            _displayHistory.DisplayHistoryChanged -= HandleDisplayHistoryChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}